# Copy to `.env.local` (git-ignored by this repo's `.env*.local` rule), fill in, then restart `npx expo start` (Expo inlines EXPO_PUBLIC_* at bundle time).

# 1) Against a DEPLOYED backend (simplest): the platform apex, https, no trailing slash.
EXPO_PUBLIC_PLATFORM_API_URL=https://yoursaas.com

# 2) Against a backend running on YOUR LAPTOP (`next dev -H 0.0.0.0`), tested from a real phone:
#    use the laptop's LAN address for BOTH, and set DEV_DEFAULT_CLUB_SLUG=<club slug> in the backend's .env.
#    Phone and laptop must be on the same Wi-Fi.
# EXPO_PUBLIC_PLATFORM_API_URL=http://192.168.1.20:3000
# EXPO_PUBLIC_DEV_CLUB_API_URL=http://192.168.1.20:3000
